diff --git a/esp32/devices/sdkconfig.muse-stackchan b/esp32/devices/sdkconfig.muse-stackchan
new file mode 100644
index 0000000..8b06412
--- /dev/null
+++ b/esp32/devices/sdkconfig.muse-stackchan
@@ -0,0 +1,25 @@
+# M5Stack StackChan: a CoreS3 on the StackChan body. Load after
+# devices/sdkconfig.muse-m5stack-cores3 to add the neck servo commands and
+# Japanese captions (the SDK's CJK caption font already has kana and kanji;
+# setup.sh can regenerate it with Hangul too).
+CONFIG_HOMEHUB_STACKCHAN_HEAD=y
+CONFIG_MUSE_CJK_FONT=y
+# BLE stays off after setup, so its memory goes to TLS and TTS; turning on
+# "Phone setup" restarts once with BLE up.
+CONFIG_MUSE_BLE_ON_DEMAND=y
+
+# "Hi, Muse" wake word: ESP-SR WakeNet10 in a "model" partition at 0x830000.
+# For "Hi, Stack Chan" instead, build with WAKE_WORD=histackchan (build.sh
+# adds an overlay that swaps in CONFIG_SR_WN_WN9L_HISTACKCHAN_TTS3).
+CONFIG_MUSE_WAKE_WORD=y
+CONFIG_SR_WN_WN10_HIMUSE=y
+CONFIG_SR_MN_CN_NONE=y
+CONFIG_SR_MN_EN_NONE=y
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_stackchan.csv"
+
+# Free about 32 KB of internal RAM for the wake word and TLS: run the BLE
+# controller and the heap functions from flash instead of IRAM. BLE interrupts
+# may wait while flash is erased (NVS writes, OTA), and the LCD's SPI interrupt
+# waits during flash operations. The app image grows by about 128 KB.
+CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
+CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
