diff --git a/esp32/main/stackchan_head.c b/esp32/main/stackchan_head.c
new file mode 100644
index 0000000..5f1feae
--- /dev/null
+++ b/esp32/main/stackchan_head.c
@@ -0,0 +1,338 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "stackchan_head.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+// Copied in from firmware/src by build.sh; tested on the host there.
+#include "stackchan_angle.h"
+#include "stackchan_head_cmd.h"
+#include "stackchan_scs.h"
+
+#include "driver/i2c_master.h"
+#include "driver/uart.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+
+static const char *TAG = "stackchan_head";
+
+// From the CoreS3 BSP, which the Muse board code has already brought up.
+extern i2c_master_bus_handle_t bsp_i2c_get_handle(void);
+
+// ---- Hardware constants (StackChan-BSP servo_init) -------------------------
+
+#define HEAD_UART       UART_NUM_1
+#define HEAD_TX_GPIO    6
+#define HEAD_RX_GPIO    7
+#define HEAD_BAUD       1000000
+
+#define PY32_ADDR       0x6F
+#define PY32_REG_VER    0x02
+#define PY32_REG_DIR_L  0x03
+#define PY32_REG_OUT_L  0x05
+#define PY32_REG_PU_L   0x09
+#define PY32_REG_PD_L   0x0B
+#define PY32_SERVO_PIN  0   // VM EN
+
+#define SCS_REG_TORQUE  40
+#define SCS_REG_GOAL    42  // position, time, speed: 3 big-endian words
+#define SCS_REG_POS     56
+#define SCS_TIMEOUT_MS  10
+
+// Commands run one at a time on one task. One more can wait behind the one
+// running; past that the command is refused as busy rather than queuing up
+// moves that would play out seconds later. The task's stack is in PSRAM so
+// it doesn't take internal RAM from TLS and TTS; it never touches flash.
+#define HEAD_QUEUE_LEN  1
+#define HEAD_STACK      4096
+
+// ---- Low-level buses --------------------------------------------------------
+
+static bool s_ready;
+static i2c_master_dev_handle_t s_py32;
+
+static esp_err_t py32_read(uint8_t reg, uint8_t *val) {
+    return i2c_master_transmit_receive(s_py32, &reg, 1, val, 1, 100);
+}
+
+static esp_err_t py32_write(uint8_t reg, uint8_t val) {
+    uint8_t buf[2] = {reg, val};
+    return i2c_master_transmit(s_py32, buf, sizeof(buf), 100);
+}
+
+static esp_err_t py32_set_bit(uint8_t reg, uint8_t bit, bool on) {
+    uint8_t v = 0;
+    esp_err_t err = py32_read(reg, &v);
+    if (err != ESP_OK) return err;
+    v = on ? (v | (1u << bit)) : (v & ~(1u << bit));
+    return py32_write(reg, v);
+}
+
+static esp_err_t servo_power_on(void) {
+    i2c_master_bus_handle_t bus = bsp_i2c_get_handle();
+    if (!bus) return ESP_ERR_INVALID_STATE;
+    const i2c_device_config_t cfg = {
+        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+        .device_address = PY32_ADDR,
+        .scl_speed_hz = 100000,
+    };
+    esp_err_t err = i2c_master_bus_add_device(bus, &cfg, &s_py32);
+    if (err != ESP_OK) return err;
+
+    // The PY32 boots slowly; the BSP waits up to 1.2 s for its version.
+    uint8_t ver = 0;
+    for (int i = 0; i < 6; i++) {
+        if (py32_read(PY32_REG_VER, &ver) == ESP_OK && ver != 0 && ver != 0xFF) break;
+        vTaskDelay(pdMS_TO_TICKS(200));
+    }
+    if (ver == 0 || ver == 0xFF) return ESP_ERR_NOT_FOUND;
+    ESP_LOGI(TAG, "PY32 IO expander version 0x%02x", ver);
+
+    if ((err = py32_set_bit(PY32_REG_DIR_L, PY32_SERVO_PIN, true)) != ESP_OK) return err;
+    if ((err = py32_set_bit(PY32_REG_PD_L, PY32_SERVO_PIN, false)) != ESP_OK) return err;
+    if ((err = py32_set_bit(PY32_REG_PU_L, PY32_SERVO_PIN, true)) != ESP_OK) return err;
+    if ((err = py32_set_bit(PY32_REG_OUT_L, PY32_SERVO_PIN, true)) != ESP_OK) return err;
+    vTaskDelay(pdMS_TO_TICKS(200));
+    return ESP_OK;
+}
+
+static esp_err_t uart_up(void) {
+    const uart_config_t cfg = {
+        .baud_rate = HEAD_BAUD,
+        .data_bits = UART_DATA_8_BITS,
+        .parity = UART_PARITY_DISABLE,
+        .stop_bits = UART_STOP_BITS_1,
+        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE,
+        .source_clk = UART_SCLK_DEFAULT,
+    };
+    esp_err_t err = uart_driver_install(HEAD_UART, 256, 0, 0, NULL, 0);
+    if (err == ESP_OK) err = uart_param_config(HEAD_UART, &cfg);
+    if (err == ESP_OK) {
+        err = uart_set_pin(HEAD_UART, HEAD_TX_GPIO, HEAD_RX_GPIO,
+                           UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE);
+    }
+    return err;
+}
+
+static esp_err_t head_init(void) {
+    if (s_ready) return ESP_OK;
+    esp_err_t err = servo_power_on();
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "servo power: %s", esp_err_to_name(err));
+        return err;
+    }
+    err = uart_up();
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "servo uart: %s", esp_err_to_name(err));
+        return err;
+    }
+    s_ready = true;
+    return ESP_OK;
+}
+
+// One SCS request (see stackchan_scs.h). Waits for the status reply and
+// copies its data into reply_data, which must be exactly reply_n bytes: a
+// write answers with none, a read with what was asked. Returns reply_n, or -1.
+static int scs_request(uint8_t id, uint8_t inst, uint8_t addr,
+                       const uint8_t *data, uint8_t n,
+                       uint8_t *reply_data, uint8_t reply_n) {
+    uint8_t pkt[SCS_PKT_MAX];
+    size_t pkt_n = scs_build(id, inst, addr, data, n, pkt, sizeof(pkt));
+    if (pkt_n == 0) return -1;
+
+    uart_flush_input(HEAD_UART);
+    uart_write_bytes(HEAD_UART, pkt, pkt_n);
+    uart_wait_tx_done(HEAD_UART, pdMS_TO_TICKS(SCS_TIMEOUT_MS));
+
+    uint8_t rx[64];
+    size_t rx_n = 0;
+    scs_reply_t reply;
+    int64_t deadline = esp_timer_get_time() + SCS_TIMEOUT_MS * 1000;
+    for (;;) {
+        scs_parse_result_t r = scs_parse(rx, rx_n, &reply, NULL);
+        if (r == SCS_PARSE_OK) break;
+        if (r == SCS_PARSE_BAD || rx_n == sizeof(rx)) return -1;
+        if (esp_timer_get_time() > deadline) return -1;
+        if (uart_read_bytes(HEAD_UART, rx + rx_n, 1, pdMS_TO_TICKS(2)) == 1) rx_n++;
+    }
+    if (reply.id != id || reply.n != reply_n) return -1;
+    if (reply_n) memcpy(reply_data, reply.data, reply_n);
+    return reply_n;
+}
+
+static bool scs_torque(uint8_t id, bool on) {
+    uint8_t v = on ? 1 : 0;
+    return scs_request(id, SCS_INST_WRITE, SCS_REG_TORQUE, &v, 1, NULL, 0) >= 0;
+}
+
+static bool scs_goal(uint8_t id, int raw, int time_ms) {
+    uint8_t d[6] = {
+        (uint8_t)(raw >> 8), (uint8_t)raw,
+        (uint8_t)(time_ms >> 8), (uint8_t)time_ms,
+        0, 0,  // speed 0: let time decide
+    };
+    return scs_request(id, SCS_INST_WRITE, SCS_REG_GOAL, d, sizeof(d), NULL, 0) >= 0;
+}
+
+static int scs_position(uint8_t id) {
+    uint8_t len = 2, d[2];
+    if (scs_request(id, SCS_INST_READ, SCS_REG_POS, &len, 1, d, 2) != 2) return -1;
+    return (d[0] << 8) | d[1];
+}
+
+// ---- Angles (deg_to_raw and friends are in stackchan_angle.c) ------------
+
+// Moves both axes and waits for the move to finish. Torque stays on so the
+// head holds its pose.
+static bool head_move(float yaw, float pitch, int duration_ms) {
+    yaw = clampf(yaw, YAW_MIN_DEG, YAW_MAX_DEG);
+    pitch = clampf(pitch, PITCH_MIN_DEG, PITCH_MAX_DEG);
+    bool ok = scs_torque(YAW_ID, true) && scs_torque(PITCH_ID, true)
+           && scs_goal(YAW_ID, deg_to_raw(YAW_ZERO_RAW, yaw), duration_ms)
+           && scs_goal(PITCH_ID, deg_to_raw(PITCH_ZERO_RAW, pitch), duration_ms);
+    if (ok) vTaskDelay(pdMS_TO_TICKS(duration_ms + 100));  // no move started otherwise
+    return ok;
+}
+
+static bool head_read(float *yaw, float *pitch) {
+    int y = scs_position(YAW_ID), p = scs_position(PITCH_ID);
+    if (y < 0 || p < 0) return false;
+    *yaw = raw_to_deg(YAW_ZERO_RAW, y);
+    *pitch = raw_to_deg(PITCH_ZERO_RAW, p);
+    return true;
+}
+
+// ---- Commands ---------------------------------------------------------------
+
+// Argument checks are in stackchan_head_cmd.c.
+typedef struct {
+    head_cmd_t cmd;
+    noise_ctrl_session_generation_t session_generation;
+    char request_id[HEAD_REQUEST_ID_MAX + 1];
+} head_job_t;
+
+static QueueHandle_t s_jobs;
+static TaskHandle_t s_task;
+
+static bool run_gesture(gesture_t g) {
+    float y0 = 0, p0 = 20;
+    head_read(&y0, &p0);  // gestures start from the current pose
+    bool ok = true;
+    switch (g) {
+    case GESTURE_NOD:
+        for (int i = 0; i < 2 && ok; i++) {
+            ok = head_move(y0, clampf(p0 + 15, PITCH_MIN_DEG, PITCH_MAX_DEG), 250)
+              && head_move(y0, p0, 250);
+        }
+        break;
+    case GESTURE_SHAKE:
+        for (int i = 0; i < 2 && ok; i++) {
+            ok = head_move(y0 - 25, p0, 250) && head_move(y0 + 25, p0, 300);
+        }
+        ok = ok && head_move(y0, p0, 250);
+        break;
+    case GESTURE_LOOK_AROUND:
+        ok = head_move(-60, 25, 900) && head_move(60, 25, 1400)
+          && head_move(y0, p0, 900);
+        break;
+    case GESTURE_HOME:
+        ok = head_move(0, 0, 800);
+        break;
+    }
+    return ok;
+}
+
+static void head_run(const head_job_t *job) {
+    cJSON *result = NULL;
+
+    if (head_init() != ESP_OK) {
+        result = head_cmd_error("hardware", "servo bus did not come up; is the StackChan base attached?");
+    } else {
+        bool ok = true;
+        const head_cmd_t *cmd = &job->cmd;
+        if (cmd->op == HEAD_MOVE) ok = head_move(cmd->yaw, cmd->pitch, cmd->duration_ms);
+        else if (cmd->op == HEAD_GESTURE) ok = run_gesture(cmd->gesture);
+
+        float yaw = 0, pitch = 0;
+        bool read_ok = head_read(&yaw, &pitch);
+        if (!ok || !read_ok) {
+            result = head_cmd_error("servo_no_reply", "a neck servo did not answer");
+        } else {
+            result = cJSON_CreateObject();
+            cJSON_AddBoolToObject(result, "ok", true);
+            cJSON *payload = cJSON_AddObjectToObject(result, "payload");
+            cJSON_AddNumberToObject(payload, "yaw_deg", roundf(yaw * 10) / 10);
+            cJSON_AddNumberToObject(payload, "pitch_deg", roundf(pitch * 10) / 10);
+        }
+    }
+
+    ESP_LOGI(TAG, "op %d done: %s", job->cmd.op,
+             cJSON_IsTrue(cJSON_GetObjectItem(result, "ok")) ? "ok" : "error");
+    noise_ctrl_send_command_result(job->session_generation, job->request_id, result);
+}
+
+static void head_task(void *arg) {
+    (void)arg;
+    head_job_t job;
+    for (;;) {
+        if (xQueueReceive(s_jobs, &job, portMAX_DELAY) == pdTRUE) head_run(&job);
+    }
+}
+
+// Starts the queue and the task once. What gets made is kept, so a failure
+// only retries what's missing next time.
+static bool head_start(void) {
+    if (s_task) return true;
+    if (!s_jobs) s_jobs = xQueueCreate(HEAD_QUEUE_LEN, sizeof(head_job_t));
+    if (!s_jobs) return false;
+    if (xTaskCreateWithCaps(head_task, "head", HEAD_STACK, NULL, 4, &s_task,
+                            MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        s_task = NULL;
+        return false;
+    }
+    return true;
+}
+
+cJSON *stackchan_head_command(const char *command, cJSON *params,
+                              const char *request_id,
+                              noise_ctrl_session_generation_t session_generation) {
+    head_cmd_t cmd;
+    head_cmd_status_t st = head_cmd_parse(command, params, &cmd);
+    if (st == HEAD_CMD_NOT_HEAD) return NULL;
+    if (st != HEAD_CMD_OK) return head_cmd_status_error(st);
+
+    if (!head_cmd_request_id_ok(request_id)) {
+        return head_cmd_error("invalid_request_id", "request_id is longer than 63 bytes");
+    }
+    if (!head_start()) return head_cmd_error("out_of_memory", "failed to start head task");
+
+    head_job_t job = {0};
+    job.cmd = cmd;
+    job.session_generation = session_generation;
+    if (request_id) memcpy(job.request_id, request_id, strlen(request_id));  // fits, checked above
+    if (xQueueSend(s_jobs, &job, 0) != pdTRUE) {
+        return head_cmd_error("busy", "the head is still moving; try again when it's done");
+    }
+    cJSON *async = cJSON_CreateObject();
+    cJSON_AddBoolToObject(async, "_async", true);
+    return async;
+}
