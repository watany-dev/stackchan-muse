diff --git a/esp32/components/muse/muse_wake.c b/esp32/components/muse/muse_wake.c
new file mode 100644
index 0000000..0a6526b
--- /dev/null
+++ b/esp32/components/muse/muse_wake.c
@@ -0,0 +1,121 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "muse_wake.h"
+
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "esp_wn_iface.h"
+#include "esp_wn_models.h"
+#include "model_path.h"
+
+static const char *TAG = "muse_wake";
+
+static const esp_wn_iface_t *s_wn;
+static model_iface_data_t *s_md;
+static int16_t *s_buf;   /* one WakeNet chunk */
+static size_t s_chunk, s_fill;
+static int s_ignore;     /* chunks to run without acting on, after a reset */
+
+static bool load(void)
+{
+    srmodel_list_t *models = esp_srmodel_init("model");
+    char *name = models ? esp_srmodel_filter(models, ESP_WN_PREFIX, NULL) : NULL;
+    if (!name) {
+        ESP_LOGW(TAG, "no WakeNet model in the \"model\" partition");
+        return false;
+    }
+    s_wn = esp_wn_handle_from_name(name);
+    s_md = s_wn ? s_wn->create(name, DET_MODE_90) : NULL;
+    if (!s_md) {
+        ESP_LOGE(TAG, "couldn't load %s", name);
+        return false;
+    }
+    s_chunk = (size_t)s_wn->get_samp_chunksize(s_md);
+    s_buf = heap_caps_malloc(s_chunk * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_buf) {
+        s_wn->destroy(s_md);
+        s_md = NULL;
+        return false;
+    }
+    ESP_LOGI(TAG, "listening for \"%s\" (%s, %u-sample chunks, %d Hz)", s_wn->get_word_name(s_md, 1), name,
+             (unsigned)s_chunk, s_wn->get_samp_rate(s_md));
+    return true;
+}
+
+bool muse_wake_feed(const int16_t *pcm, size_t frames)
+{
+    if (!s_md) {
+        return false;
+    }
+    bool heard = false;
+    while (frames) {
+        size_t take = s_chunk - s_fill < frames ? s_chunk - s_fill : frames;
+        memcpy(s_buf + s_fill, pcm, take * sizeof(int16_t));
+        s_fill += take;
+        pcm += take;
+        frames -= take;
+        if (s_fill == s_chunk) {
+            s_fill = 0;
+            if (s_wn->detect(s_md, s_buf) == WAKENET_DETECTED && s_ignore <= 0) {
+                heard = true;
+            }
+            if (s_ignore > 0) {
+                s_ignore--;
+            }
+        }
+    }
+    return heard;
+}
+
+/*
+ * Loading maps the model partition, which freezes the caches: the caller's
+ * stack must then be in internal RAM, and the voice task's is in PSRAM. So it
+ * loads on a short-lived task with an internal stack.
+ */
+static TaskHandle_t s_waiter;
+static bool s_loaded;
+
+static void load_task(void *arg)
+{
+    s_loaded = load();
+    xTaskNotifyGive(s_waiter);
+    vTaskDelete(NULL);
+}
+
+bool muse_wake_init(void)
+{
+    s_waiter = xTaskGetCurrentTaskHandle();
+    if (xTaskCreate(load_task, "wake_load", 6144, NULL, 5, NULL) != pdPASS) {
+        ESP_LOGE(TAG, "no memory to load the model");
+        return false;
+    }
+    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+    return s_loaded;
+}
+
+/*
+ * esp-sr's wn9l clean() dereferences a NULL queue and panics (seen in 2.5.5),
+ * so no model is cleaned: its window still holds the wake word, and detections
+ * are ignored until about 1.5 s of new audio has gone through it.
+ */
+void muse_wake_reset(void)
+{
+    s_fill = 0;
+    s_ignore = s_chunk ? (int)(16000 * 3 / 2 / s_chunk) : 0;
+}
diff --git a/esp32/components/muse/muse_wake.h b/esp32/components/muse/muse_wake.h
new file mode 100644
index 0000000..51c9b6a
--- /dev/null
+++ b/esp32/components/muse/muse_wake.h
@@ -0,0 +1,34 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Hands-free wake word (CONFIG_MUSE_WAKE_WORD): ESP-SR WakeNet on the idle
+ * mic audio. The model comes from the "model" partition, which esp-sr's build
+ * fills with the WakeNet chosen in menuconfig (CONFIG_SR_WN_*).
+ */
+
+/* Loads the model. False if it isn't there; feeding is then a no-op. */
+bool muse_wake_init(void);
+
+/* Feeds 16 kHz mono audio; true when the wake word has just been heard. */
+bool muse_wake_feed(const int16_t *pcm, size_t frames);
+
+/* Drops buffered audio, e.g. after Muse spoke or recorded. */
+void muse_wake_reset(void);
