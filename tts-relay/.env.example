# .env にコピーして使う(.env は .gitignore 済み)。
# TTS_KEY は README の手順で末尾に追記する(openssl rand -hex 24)。16 バイト未満や空だと起動しない
PORT=3710
# 声(edge-tts の voice 名)。かな→日本語、ハングル→韓国語、それ以外→英語で選ぶ
# TTS_VOICE_JA=ja-JP-NanamiNeural
# TTS_VOICE_KO=ko-KR-SunHiNeural
# TTS_VOICE_EN=en-US-AriaNeural
# 漢字だけの返答をどの言語で読むか(ja / ko / en)
# TTS_DEFAULT_LANG=ja
